  "narrative": {
    "northStar": "The Rack",
    "overview": "FlowSynth renders as a synthesizer instrument: a hex-grid board of panel-standard modules where color is functional — hue names the category, finish names the rarity, light names the charge — surrounded by flat, quiet instrument panels in condensed technical lettering with monospace tabular readouts. The player glances at it mid-practice; every surface is built to be read in a flick of attention, never studied. The system explicitly rejects the consumer-app voice: rounded controls, nested cards, details expandables, boxed tooltips, explanatory paragraphs, and mechanics words as product names. Depth is carried by panel tiers and hairlines, never shadows or texture; glow and motion are earned only by charge and live activity.",
    "keyCharacteristics": [
      "Hexes are the module voice; panels are flat, open, and divided by hairlines",
      "Color is the board language; console surfaces stay monochrome but for the vermillion switch",
      "One four-state grammar everywhere, recognizable without color",
      "Square-cut controls at zero radius, hairline borders, condensed caps",
      "Tabular monospace figures for every readout",
      "Compact name + state + effect readouts; deeper mechanics in a plain tooltip layer"
    ],
    "rules": [
      {
        "name": "The Register Rule",
        "body": "A reserved resource hue anchors its producing category: modules wear the saturated LED register; the resource wears the luminous glow register of the same hue — generator to charge green, oscillator to nous indigo.",
        "section": "colors"
      },
      {
        "name": "The Monochrome Console Rule",
        "body": "The console is graphite and ink; color is the board language. The vermillion switch — and its session-strip expression — is the sole exception.",
        "section": "colors"
      },
      {
        "name": "The Finish Rule",
        "body": "Rarity is a finish, not a color: engraved rings plus a faint plate tint, never glowing, never taking a hue.",
        "section": "colors"
      },
      {
        "name": "Glow is Charge",
        "body": "Glow and motion are for charge and live activity only. Idle panels stay quiet; an animated element means something is live.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every figure that can change renders in monospace with tabular-nums. Readouts hold their size — layout never shifts as numbers tick.",
        "section": "typography"
      },
      {
        "name": "The Three-Jobs Rule",
        "body": "Condensed caps for names and controls, mono for numbers, sans for prose. A face used outside its job is a review flag.",
        "section": "typography"
      },
      {
        "name": "The Whole-Step Rule",
        "body": "Every font-size in the stylesheet is a step on the type ramp, in whole pixels. A half-pixel size is drift; a size off the ramp is a review flag.",
        "section": "typography"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "If a resting surface needs a shadow to read as a surface, the tier is wrong. Shadows belong to sheets over the board, nothing else.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the instrument standards and pinned prototypes authoritative; this file captures, that file decides.",
      "Do square-cut every control (0 radius, hairline border, condensed caps); use the four-state grammar with its non-color marks.",
      "Do set every readout in tabular mono figures with units; keep the name + state + effect readout compact (Chords (4/11) +8% ν).",
      "Do pair every category hue with a glyph, and mutators lead wherever modules and mutators co-list.",
      "Do earn every glow and animation with charge or live activity, and honor prefers-reduced-motion with state surviving intact."
    ],
    "donts": [
      "Don't round anything — border-radius on buttons, pills, chips is the retired consumer voice.",
      "Don't nest cards or ship details expandables inside panels — open divisions and hairline rules only.",
      "Don't box a tooltip or give it shadow; the layer is floating plain text, and a tooltip that restates visible content is deleted, not moved.",
      "Don't name a purchase with a mechanics word (First ceiling) — products carry proper names with one effect line.",
      "Don't use SaaS landing grammar: hero metrics, gradient text, eyebrow kickers, identical card grids — none of it belongs on the rack.",
      "Don't texture or bevel — flat-light discipline; the rack is a design language, not a texture budget.",
      "Don't let color alone carry state, and don't spend the console monochrome on anything but the switch."
    ]
  }
}
