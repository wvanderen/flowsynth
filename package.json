{
  "name": "flowsynth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FlowSynth first playable: a modular focus instrument driven by real practice.",
  "scripts": {
    "dev": "node tools/run-supported.mjs tools/dev-server.mjs",
    "build": "node tools/run-supported.mjs node_modules/typescript/bin/tsc --noEmit && node tools/run-supported.mjs node_modules/vite/bin/vite.js build",
    "preview": "node tools/run-supported.mjs node_modules/vite/bin/vite.js preview",
    "test": "node tools/run-supported.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node tools/run-supported.mjs node_modules/vitest/vitest.mjs",
    "test:calendar": "node tools/run-supported.mjs tools/calendar-regression.mjs",
    "check": "node tools/run-supported.mjs node_modules/typescript/bin/tsc --noEmit",
    "preflight": "node tools/runtime-preflight.mjs",
    "deploy:vercel": "vercel build --prod && vercel deploy --prebuilt --prod"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "happy-dom": "^20.14.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.12"
  }
}
